---
const testimonials = [
  { quote: "I deleted Cora just to feel the difference it makes. And the difference was felt. Scrambling to connect my emails to it again.", name: "Brett Dashevsky", role: "Founder at", logo: "/images/logos/creatoreconomy.png", avatar: "/images/people/brettdashevsky.jpg" },
  { quote: "I've tried all these newfangled AI email apps, and the winner, by far, is Cora by Every.", name: "Andrew Wilkinson", role: "Founder at", logo: "/images/logos/tiny.png", avatar: "/images/people/andrewwilkinson.jpg" },
  { quote: "This morning was a record; it categorized every single email I received, left me with inbox zero and a nice Brief to read instead.", name: "Mike Krieger", role: "CPO at", logo: "/images/logos/anthropic.png", avatar: "/images/people/mikekrieger.jpg" },
  { quote: "I've been using Cora for a few months now. I'm at inbox zero pretty much all the time and replying to the important emails at record speed.", name: "Danny Aziz", role: "Founder of", logo: "/images/logos/spiral.png", avatar: "/images/people/dannyaziz.png" },
  { quote: "Storytelling and design on steroids. Genuinely the nicest software I've used all year.", name: "Jim Raptis", role: "GM of", logo: "/images/logos/magicpattern.png", avatar: "/images/people/jimraptis.jpg" },
  { quote: "Using Cora for the last month has changed the way I deal with email.", name: "Mitchell Baldridge", role: "Founder of", logo: "/images/logos/recostseg.png", avatar: "/images/people/mitchellbaldridge.jpg" },
  { quote: "Been in since release, I have opened every single summary. Still feels like magic.", name: "Aodhán Moran", role: "Cofounder of", logo: "/images/logos/castcraft.png", avatar: "/images/people/aodhanmoran.jpg" },
  { quote: "AI now reads and summarizes all my newsletters, and its dry, businesslike recaps are becoming my favorite form of media.", name: "Kevin Roose", role: "Columnist at", logo: "/images/logos/nytimes.svg", avatar: "/images/people/kevinroose.jpg" },
];
const rowA = testimonials;
const rowB = [...testimonials].reverse();
---
<section class="tm section">
  <div class="tm__row" data-marquee data-speed="55">
    <div class="tm__track">
      {[...rowA, ...rowA].map((t) => (
        <figure class="tm__card">
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <img class="tm__avatar" src={t.avatar} alt={t.name} width="40" height="40" loading="lazy" />
            <span class="tm__who">
              <strong>{t.name}</strong>
              <span class="tm__role">{t.role} <img class="tm__logo" src={t.logo} alt="" loading="lazy" /></span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
  <div class="tm__row" data-marquee data-speed="70" data-reverse>
    <div class="tm__track">
      {[...rowB, ...rowB].map((t) => (
        <figure class="tm__card">
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <img class="tm__avatar" src={t.avatar} alt={t.name} width="40" height="40" loading="lazy" />
            <span class="tm__who">
              <strong>{t.name}</strong>
              <span class="tm__role">{t.role} <img class="tm__logo" src={t.logo} alt="" loading="lazy" /></span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .tm {
    padding: clamp(48px, 8vw, 96px) 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .tm__row { overflow: hidden; }
  .tm__track {
    display: flex;
    gap: 20px;
    width: max-content;
    will-change: transform;
  }
  .tm__card {
    flex: 0 0 auto;
    width: 360px;
    background: #fff;
    border-radius: var(--radius-cards);
    padding: 22px 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
  }
  .tm__card blockquote {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-ink);
    font-weight: 400;
  }
  .tm__card figcaption { display: flex; align-items: center; gap: 12px; }
  .tm__avatar { border-radius: 50%; width: 40px; height: 40px; object-fit: cover; flex: 0 0 auto; }
  .tm__who { display: flex; flex-direction: column; gap: 3px; line-height: 1.2; min-width: 0; }
  .tm__who strong { font-size: 14px; font-weight: 600; color: var(--color-ink); }
  .tm__role { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--color-stone); }
  .tm__logo { height: 15px; width: auto; max-width: 92px; object-fit: contain; opacity: .85; }
  @media (max-width: 640px) {
    .tm__card { width: 280px; }
  }
</style>
